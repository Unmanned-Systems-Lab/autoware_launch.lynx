<launch>
  <arg name="input_objects_topic_name" default="/perception/object_recognition/objects"/>
  <arg name="input_pointcloud_topic_name" default="/perception/obstacle_segmentation/pointcloud"/>
  <arg
    name="freespace_static_occupancy_map_yaml"
    default="/home/lhl/autoware.lynx/src/launcher/autoware_launch.lynx/lynx_maps/GlobalMap_occupancy.yaml"
  />
  <arg name="use_static_only_costmap" default="false"/>
  <arg
    name="static_occupancy_grid_topic"
    default="/planning/scenario_planning/parking/static_occupancy_grid"
  />
  <arg
    name="compat_occupancy_grid_topic"
    default="/planning/scenario_planning/parking/costmap_generator/occupancy_grid"
  />
  <arg
    name="compat_occupancy_grid_raw_topic"
    default="/planning/scenario_planning/parking/costmap_generator/occupancy_grid_raw"
  />

  <!-- parking scenario -->
  <group if="$(var launch_parking_module)">
    <push-ros-namespace namespace="parking"/>

    <node_container pkg="rclcpp_components" exec="$(var container_type)" name="parking_container" namespace="" output="screen">
      <composable_node pkg="autoware_costmap_generator" plugin="autoware::costmap_generator::CostmapGenerator" name="costmap_generator" namespace="" unless="$(var use_static_only_costmap)">
        <!-- topic remap -->
        <remap from="~/input/objects" to="$(var input_objects_topic_name)"/>
        <remap from="~/input/points_no_ground" to="$(var input_pointcloud_topic_name)"/>
        <remap from="~/input/vector_map" to="/map/vector_map"/>
        <remap from="~/input/scenario" to="/planning/scenario_planning/scenario"/>
        <remap from="~/output/grid_map" to="costmap_generator/grid_map"/>
        <remap from="~/output/occupancy_grid" to="costmap_generator/occupancy_grid_raw"/>
        <!-- params -->
        <param from="$(var vehicle_param_file)"/>
        <param from="$(var costmap_generator_param_path)"/>
        <extra_arg name="use_intra_process_comms" value="false"/>
      </composable_node>

      <composable_node pkg="autoware_freespace_planner" plugin="autoware::freespace_planner::FreespacePlannerNode" name="freespace_planner" namespace="" unless="$(var use_static_only_costmap)">
        <!-- topic remap -->
        <remap from="~/input/route" to="/planning/mission_planning/route"/>
        <remap from="~/input/goal" to="/planning/mission_planning/goal"/>
        <remap from="~/input/scenario" to="/planning/scenario_planning/scenario"/>
        <remap from="~/input/occupancy_grid" to="costmap_generator/occupancy_grid"/>
        <remap from="~/input/odometry" to="/localization/kinematic_state"/>
        <remap from="~/output/trajectory" to="/planning/scenario_planning/parking/trajectory"/>
        <remap from="is_completed" to="/planning/scenario_planning/parking/is_completed"/>
        <!-- params -->
        <param from="$(var vehicle_param_file)"/>
        <param from="$(var freespace_planner_param_path)"/>
        <extra_arg name="use_intra_process_comms" value="false"/>
      </composable_node>
      <composable_node pkg="autoware_freespace_planner" plugin="autoware::freespace_planner::FreespacePlannerNode" name="freespace_planner" namespace="" if="$(var use_static_only_costmap)">
        <!-- topic remap -->
        <remap from="~/input/route" to="/planning/mission_planning/route"/>
        <remap from="~/input/goal" to="/planning/mission_planning/goal"/>
        <remap from="~/input/scenario" to="/planning/scenario_planning/scenario"/>
        <remap from="~/input/occupancy_grid" to="$(var static_occupancy_grid_topic)"/>
        <remap from="~/input/odometry" to="/localization/kinematic_state"/>
        <remap from="~/output/trajectory" to="/planning/scenario_planning/parking/trajectory"/>
        <remap from="is_completed" to="/planning/scenario_planning/parking/is_completed"/>
        <!-- params -->
        <param from="$(var vehicle_param_file)"/>
        <param from="$(var freespace_planner_param_path)"/>
        <extra_arg name="use_intra_process_comms" value="false"/>
      </composable_node>

      <composable_node pkg="autoware_glog_component" plugin="autoware::glog_component::GlogComponent" name="glog_component" namespace=""/>
    </node_container>

    <executable
      cmd="python3 $(find-pkg-share autoware_launch)/launch/tools/costmap_static_overlay_node.py --input-topic /planning/scenario_planning/parking/costmap_generator/occupancy_grid_raw --output-topic /planning/scenario_planning/parking/costmap_generator/occupancy_grid --static-map-yaml $(var freespace_static_occupancy_map_yaml)"
      name="parking_costmap_static_overlay"
      output="screen"
      shell="true"
      unless="$(var use_static_only_costmap)"
    />
    <executable
      cmd="python3 $(find-pkg-share autoware_launch)/launch/tools/static_occupancy_map_publisher.py --map-yaml $(var freespace_static_occupancy_map_yaml) --output-topic $(var static_occupancy_grid_topic)"
      name="parking_static_occupancy_map_publisher"
      output="screen"
      shell="true"
      if="$(var use_static_only_costmap)"
    />
    <node
      pkg="topic_tools"
      exec="relay"
      name="parking_static_costmap_compat_relay"
      output="log"
      args="$(var static_occupancy_grid_topic) $(var compat_occupancy_grid_topic)"
      if="$(var use_static_only_costmap)"
    />
    <node
      pkg="topic_tools"
      exec="relay"
      name="parking_static_costmap_raw_compat_relay"
      output="log"
      args="$(var static_occupancy_grid_topic) $(var compat_occupancy_grid_raw_topic)"
      if="$(var use_static_only_costmap)"
    />
  </group>
</launch>

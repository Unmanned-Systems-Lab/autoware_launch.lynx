<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_gui" default="true"/>
  <arg name="launch_rviz" default="false"/>

  <let name="description_share" value="$(find-pkg-share lynx_vehicle_description)"/>
  <let name="urdf_path" value="$(var description_share)/urdf/vehicle_with_sensor_6.urdf"/>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" name="joint_state_publisher_gui" if="$(var use_gui)"/>
  <node pkg="joint_state_publisher" exec="joint_state_publisher" name="joint_state_publisher" unless="$(var use_gui)"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'cat $(var urdf_path)')"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" if="$(var launch_rviz)"/>
</launch>
